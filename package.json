{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "notes:generate": "tsc -p tsconfig.notes-gen.json && node dist-notes-gen/scripts/generate-notes.js",
    "dev": "npm run notes:generate && next dev -p 33333",
    "build": "npm run notes:generate && next build",
    "pages:build": "npm run notes:generate && next build && next-on-pages",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-fast-marquee": "^1.6.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.57.0"
  }
}
